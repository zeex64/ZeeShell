pragma Singleton

import Quickshell
import Quickshell.Hyprland
import Quickshell.Io
import QtQuick
import qs.config

// Hands the monitor layout and the input options chosen in Settings to
// Hyprland. With a Lua config and the installer's hooks they are written to
// ~/.config/hypr/zeeshell/system.lua, which Hyprland loads itself, so they hold
// from the first frame of a session. In every other setup they are applied at
// run time: when the shell starts, when they change, and after a config reload.
Singleton {
    id: root

    readonly property bool dry: !!Quickshell.env("ZEE_DRY")
    readonly property string hyprDir: (Quickshell.env("XDG_CONFIG_HOME") || Config.home + "/.config") + "/hypr"
    property bool fileLoaded: false // the Hyprland config loads system.lua
    property bool probed: false
    property bool known: false // system.lua has been read (or found missing)
    property string onDisk: ""
    property var applied: null // what Hyprland was last told, as Lua text

    function luaValue(v) { return typeof v === "string" ? JSON.stringify(v) : String(v); }

    function monitorLua(name, r) {
        if (r.disabled) return "hl.monitor({ output = " + JSON.stringify(name) + ", disabled = true })";
        return "hl.monitor({ output = " + JSON.stringify(name) + ", mode = " + JSON.stringify(r.mode)
            + ", position = \"" + Math.round(r.x) + "x" + Math.round(r.y) + "\", scale = " + r.scale
            + ", transform = " + (r.transform || 0) + ", vrr = " + (r.vrr || 0) + " })";
    }
    function monitorKeyword(name, r) {
        if (r.disabled) return "keyword monitor " + name + ",disable";
        return "keyword monitor " + [name, r.mode, Math.round(r.x) + "x" + Math.round(r.y), r.scale, "transform", r.transform || 0, "vrr", r.vrr || 0].join(",");
    }

    // { "kb_layout": "us", "touchpad:natural_scroll": true } -> input = { kb_layout = "us", touchpad = { natural_scroll = true } }
    function inputLua(o) {
        const flat = [], groups = {};
        // Lua spells option names with underscores: tap-to-click is tap_to_click.
        const id = s => s.replace(/-/g, "_");
        for (const k in o) {
            const i = k.indexOf(":");
            if (i < 0) flat.push(id(k) + " = " + luaValue(o[k]));
            else (groups[id(k.slice(0, i))] = groups[id(k.slice(0, i))] || []).push(id(k.slice(i + 1)) + " = " + luaValue(o[k]));
        }
        for (const g in groups) flat.push(g + " = { " + groups[g].join(", ") + " }");
        return flat.length ? "hl.config({ input = { " + flat.join(", ") + " } })" : "";
    }

    readonly property var statements: {
        const out = [], m = Config.display.monitors;
        for (const name in m) out.push(monitorLua(name, m[name]));
        const i = inputLua(Config.input.overrides);
        if (i !== "") out.push(i);
        return out;
    }
    readonly property var keywords: {
        const out = [], m = Config.display.monitors, o = Config.input.overrides;
        for (const name in m) out.push(monitorKeyword(name, m[name]));
        for (const k in o) out.push("keyword input:" + k + " " + o[k]);
        return out;
    }
    readonly property string lua: "-- Generated by ZeeShell (Settings -> Display and Input). Do not edit: it is\n"
        + "-- rewritten when those settings change. Remove a setting there to get your own back.\n"
        + statements.join("\n") + (statements.length ? "\n" : "")

    function run(luaLines, keywordLines) {
        if (dry) return;
        if (Hypr.lua) { if (luaLines.length) Quickshell.execDetached(["hyprctl", "eval", luaLines.join("\n")]); }
        else if (keywordLines.length) Quickshell.execDetached(["hyprctl", "--batch", keywordLines.join(" ; ")]);
    }

    // Try a monitor layout without saving it (Settings shows a "keep?" countdown).
    function tryMonitors(rules) {
        const l = [], k = [];
        for (const name in rules) { l.push(monitorLua(name, rules[name])); k.push(monitorKeyword(name, rules[name])); }
        run(l, k);
    }

    // Settings were removed: only a reload brings the config file's values back.
    function reload() { if (!dry) reloadTimer.restart(); }

    function sync() {
        if (dry || !Config.ready || !Hypr.probed || !probed || !known) return;
        const usesFile = Hypr.lua && Hypr.hooked;
        if (usesFile && lua !== onDisk) {
            onDisk = lua;
            file.setText(lua);
        }
        if (applied === lua) return;
        // At startup Hyprland has already loaded the file: nothing to repeat.
        const fresh = applied === null && usesFile && fileLoaded;
        applied = lua;
        if (!fresh) run(statements, keywords);
    }

    onLuaChanged: syncTimer.restart()
    onKnownChanged: syncTimer.restart()
    onProbedChanged: syncTimer.restart()

    Connections {
        target: Hypr
        function onProbedChanged() { syncTimer.restart(); }
        function onHookedChanged() { syncTimer.restart(); }
    }

    Connections {
        target: Config
        function onReadyChanged() { syncTimer.restart(); }
    }

    Timer { id: syncTimer; interval: 350; onTriggered: root.sync() }
    Timer { id: reloadTimer; interval: 700; onTriggered: Quickshell.execDetached(["hyprctl", "reload"]) }

    FileView {
        id: file
        path: Config.ready ? root.hyprDir + "/zeeshell/system.lua" : ""
        printErrors: false
        onLoaded: { root.onDisk = text(); root.known = true; }
        onLoadFailed: { root.onDisk = ""; root.known = true; }
    }

    Process {
        id: check
        command: ["sh", "-c", "grep -q 'system\\.lua' \"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua\" 2>/dev/null"]
        running: true
        onExited: code => { root.fileLoaded = code === 0; root.probed = true; }
    }

    Connections {
        target: Hyprland
        function onRawEvent(event) {
            if (event.name !== "configreloaded") return;
            check.running = true;
            // A reload puts the config file's values back. Unless the file is
            // part of that config, say it all again.
            if (!(Hypr.lua && Hypr.hooked && root.fileLoaded)) { root.applied = ""; syncTimer.restart(); }
        }
    }
}
