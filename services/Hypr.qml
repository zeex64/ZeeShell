pragma Singleton

import Quickshell
import Quickshell.Hyprland
import Quickshell.Io
import QtQuick
import qs.config

// Hyprland glue: workspace switching (classic and Lua configs) and keybinds.
Singleton {
    id: root

    property bool lua: false
    property bool probed: false
    property bool hooked: false // install.sh has added ZeeShell's hooks to Hyprland
    property var binds: []
    readonly property var focusedWorkspace: Hyprland.focusedWorkspace
    readonly property int activeId: focusedWorkspace ? focusedWorkspace.id : 1
    readonly property string activeTitle: Hyprland.activeToplevel ? Hyprland.activeToplevel.title : ""

    function workspace(id) {
        Hyprland.dispatch(lua ? "hl.dsp.focus({ workspace = " + id + " })" : "workspace " + id);
    }

    function refreshBinds() { bindProc.running = true; }

    // ---- windows ---------------------------------------------------------
    // Which app is on which workspace, kept current from Hyprland's events.
    readonly property bool dry: !!Quickshell.env("ZEE_DRY")
    readonly property string hyprDir: (Quickshell.env("XDG_CONFIG_HOME") || Config.home + "/.config") + "/hypr"
    property var windows: ({}) // address -> { cls, ws }
    property var specials: ({}) // monitor name -> special workspace showing on it

    function appIcon(cls) {
        const e = DesktopEntries.heuristicLookup(cls);
        return Quickshell.iconPath(e && e.icon ? e.icon : cls.toLowerCase(), "application-x-executable");
    }

    function trackEvent(event) {
        const d = event.data;
        if (event.name === "activespecial") {
            const i = d.lastIndexOf(","), s = Object.assign({}, specials);
            s[d.slice(i + 1)] = d.slice(0, i);
            specials = s;
        } else if (event.name === "openwindow") {
            const f = d.split(","), w = Object.assign({}, windows), n = parseInt(f[1]);
            w[f[0]] = { cls: f[2], ws: isNaN(n) ? -1 : n, name: f[1] };
            windows = w;
        } else if (event.name === "closewindow") {
            if (!windows[d]) return;
            const w = Object.assign({}, windows);
            delete w[d];
            windows = w;
        } else if (event.name === "movewindowv2") {
            const f = d.split(",");
            if (!windows[f[0]]) return;
            const w = Object.assign({}, windows);
            w[f[0]] = { cls: windows[f[0]].cls, ws: parseInt(f[1]), name: f[2] };
            windows = w;
        }
    }

    Process {
        id: sync
        command: ["sh", "-c", "hyprctl monitors -j; echo '---split---'; hyprctl clients -j"]
        running: true
        stdout: StdioCollector {
            onStreamFinished: {
                const parts = text.split("---split---");
                try {
                    const s = {}, w = {};
                    for (const m of JSON.parse(parts[0])) s[m.name] = m.specialWorkspace ? m.specialWorkspace.name : "";
                    for (const c of JSON.parse(parts[1])) w[c.address.replace(/^0x/, "")] = { cls: c.class, ws: c.workspace.id, name: c.workspace.name };
                    root.specials = s;
                    root.windows = w;
                } catch (e) {}
            }
        }
    }

    // ---- Steam workspace -------------------------------------------------
    // Steam lives in the special workspace "steam" (Hyprland's lua/steam.lua).
    // Its switches in Settings reach that file through a generated flags file.
    readonly property string steamSpecial: "special:steam"
    readonly property bool steamShown: {
        for (const m in specials) if (specials[m] === steamSpecial) return true;
        return false;
    }
    readonly property bool steamRunning: {
        for (const a in windows) if (windows[a].cls === "steam") return true;
        return false;
    }

    function toggleSteam() {
        if (!Config.steam.enabled) return;
        Quickshell.execDetached(lua ? ["hyprctl", "eval", "steam_workspace_toggle()"] : ["hyprctl", "dispatch", "togglespecialworkspace", "steam"]);
    }

    readonly property string flagsLua: "-- Generated by ZeeShell (Settings). Do not edit: it is rewritten when those settings change.\n"
        + "return {\n\tsteam = { enabled = " + Config.steam.enabled + ", autostart = " + Config.steam.autostart
        + ", fill = " + Config.steam.fill + ", friends = " + Config.steam.friends + " },\n}\n"
    property string flagsOnDisk: ""
    property bool flagsKnown: false

    function applyFlags() {
        if (dry || !Config.ready || !flagsKnown || !probed || !lua || !hooked) return;
        if (flagsLua === flagsOnDisk) return;
        flagsOnDisk = flagsLua;
        flagsFile.setText(flagsLua);
        flagsReload.restart();
    }

    onFlagsLuaChanged: flagsWrite.restart()
    onProbedChanged: flagsWrite.restart()
    onHookedChanged: flagsWrite.restart()

    Timer { id: flagsWrite; interval: 450; onTriggered: root.applyFlags() }
    Timer { id: flagsReload; interval: 300; onTriggered: { Quickshell.execDetached(["hyprctl", "reload"]); steamHome.restart(); } }

    // After the switch changes, put Steam's windows where they now belong:
    // into the special workspace, or back out onto the current one.
    Timer {
        id: steamHome
        interval: 900
        onTriggered: Quickshell.execDetached(["hyprctl", "eval", Config.steam.enabled
            ? "for _, w in pairs(hl.get_windows()) do if w.class == 'steam' and w.workspace and w.workspace.name ~= 'special:steam' then hl.dispatch(hl.dsp.window.move({ workspace = 'special:steam', window = w, silent = true })) end end"
            : "local t = tostring(hl.get_active_workspace().id) for _, w in pairs(hl.get_windows()) do if w.class == 'steam' and w.workspace and w.workspace.name == 'special:steam' then hl.dispatch(hl.dsp.window.move({ workspace = t, window = w, silent = true })) end end"])
    }

    FileView {
        id: flagsFile
        path: Config.ready ? root.hyprDir + "/zeeshell/flags.lua" : ""
        printErrors: false
        onLoaded: { root.flagsOnDisk = text(); root.flagsKnown = true; flagsWrite.restart(); }
        onLoadFailed: { root.flagsOnDisk = ""; root.flagsKnown = true; flagsWrite.restart(); }
    }

    // ---- window styling ------------------------------------------------
    // Hyprland's own windows follow the shell theme: rounding, gaps, an accent
    // border and shadows. Re-applied whenever the theme or the config changes.
    function hex(c) {
        const h = n => Math.round(Math.max(0, Math.min(1, n)) * 255).toString(16).padStart(2, "0");
        return h(c.r) + h(c.g) + h(c.b) + h(c.a);
    }

    readonly property var themeCmd: {
        const w = Config.windows, p = Theme.target;
        if (!Config.ready || !probed || !w.enabled) return [];
        const rounding = Math.round(w.rounding * Config.appearance.rounding);
        const active = "rgba(" + hex(w.accentBorder ? p.accent : p.textMute) + ")";
        const inactive = "rgba(" + hex(Qt.alpha(p.surfaceTop, 0.9)) + ")";
        const shadow = "rgba(000000" + (Config.appearance.dark ? "70" : "38") + ")";
        if (lua) {
            return ["hyprctl", "eval", "hl.config({ general = { gaps_in = " + w.gapsIn
                + ", gaps_out = { top = " + w.gapsOut + ", right = " + w.gapsOut + ", bottom = " + w.gapsOut + ", left = " + w.gapsOut + " }"
                + ", border_size = " + w.borderSize
                + ", col = { active_border = \"" + active + "\", inactive_border = \"" + inactive + "\" } }"
                + ", decoration = { rounding = " + rounding
                + ", shadow = { enabled = " + (w.shadows ? "true" : "false") + ", range = 26, render_power = 3, color = \"" + shadow + "\" } } })"];
        }
        return ["hyprctl", "--batch", [
            "keyword general:gaps_in " + w.gapsIn,
            "keyword general:gaps_out " + w.gapsOut,
            "keyword general:border_size " + w.borderSize,
            "keyword general:col.active_border " + active,
            "keyword general:col.inactive_border " + inactive,
            "keyword decoration:rounding " + rounding,
            "keyword decoration:shadow:enabled " + (w.shadows ? "true" : "false"),
            "keyword decoration:shadow:range 26",
            "keyword decoration:shadow:render_power 3",
            "keyword decoration:shadow:color " + shadow
        ].join(" ; ")];
    }

    onThemeCmdChanged: themeTimer.restart()

    Timer {
        id: themeTimer
        interval: 140
        onTriggered: if (root.themeCmd.length) Quickshell.execDetached(root.themeCmd)
    }

    // Turning the feature off hands styling back to the Hyprland config.
    Connections {
        target: Config.windows
        function onEnabledChanged() { if (!Config.windows.enabled && Config.ready) Quickshell.execDetached(["hyprctl", "reload"]); }
    }

    function modNames(mask) {
        const out = [];
        if (mask & 64) out.push("Super");
        if (mask & 4) out.push("Ctrl");
        if (mask & 8) out.push("Alt");
        if (mask & 1) out.push("Shift");
        return out;
    }

    function keyLabel(key) {
        const map = {
            Return: "Enter", Escape: "Esc", space: "Space", Space: "Space", Print: "PrtSc", Tab: "Tab",
            left: "←", right: "→", up: "↑", down: "↓", Left: "←", Right: "→", Up: "↑", Down: "↓",
            mouse_down: "Scroll ↓", mouse_up: "Scroll ↑", "mouse:272": "LMB", "mouse:273": "RMB", "mouse:274": "MMB",
            XF86AudioMute: "Mute", XF86AudioRaiseVolume: "Vol +", XF86AudioLowerVolume: "Vol −",
            XF86AudioPlay: "Play", XF86AudioNext: "Next", XF86AudioPrev: "Prev", XF86AudioStop: "Stop",
            XF86AudioMicMute: "Mic mute", XF86MonBrightnessUp: "Bright +", XF86MonBrightnessDown: "Bright −",
            comma: ",", period: ".", slash: "/", minus: "−", equal: "=", grave: "`", semicolon: ";",
            bracketleft: "[", bracketright: "]", backslash: "\\", apostrophe: "'"
        };
        if (map[key] !== undefined) return map[key];
        return key.length === 1 ? key.toUpperCase() : key;
    }

    function category(b) {
        const d = ((b.description || "") + " " + b.dispatcher + " " + b.arg).toLowerCase();
        if (/workspace/.test(d)) return "Workspaces";
        if (/volume|mute|brightness|play|track|media|playback|mic/.test(d)) return "Media";
        if (/screenshot|hyprshot|picker|record|capture|clipboard/.test(d)) return "Capture";
        if (/window|focus|float|fullscreen|pin|resize|move|kill|close|split|group|minimi/.test(d)) return "Windows";
        if (/menu|launcher|settings|shell|panel|sidebar|bar|lock|power|session|exit|logout|suspend|wallpaper|cheat|notif|dashboard/.test(d)) return "Shell";
        if (/^open |exec/.test(d)) return "Apps";
        return "Other";
    }

    Process {
        id: bindProc
        command: ["hyprctl", "binds", "-j"]
        running: true
        stdout: StdioCollector {
            onStreamFinished: {
                let raw = [];
                try { raw = JSON.parse(text); } catch (e) { return; }
                root.lua = raw.some(b => (b.dispatcher || "").startsWith("HL.Dispatcher"));
                const out = [];
                for (const b of raw) {
                    if (b.key === "" && !b.keycode) continue;
                    if (b.release && /^(ALT|SUPER|CONTROL|SHIFT|META)_[LR]$/i.test(b.key)) continue; // Alt-Tab's "let go of Alt"
                    const disp = (b.dispatcher || "").replace(/^HL\.Dispatcher\((.*)\)$/, "$1");
                    const desc = b.description || (disp + (b.arg && !/^\d+$/.test(b.arg) ? " " + b.arg : ""));
                    out.push({
                        mods: root.modNames(b.modmask),
                        key: root.keyLabel(b.key || ("code:" + b.keycode)),
                        description: desc,
                        submap: b.submap || "",
                        category: root.category(Object.assign({}, b, { dispatcher: disp }))
                    });
                }
                root.binds = out;
            }
        }
    }

    Process {
        id: hookCheck
        command: ["sh", "-c", "test -f \"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/zeeshell/probe.lua\""]
        running: true
        onExited: code => root.hooked = code === 0
    }

    Process {
        command: ["sh", "-c", "test -f \"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua\""]
        running: true
        onExited: code => {
            if (code === 0) root.lua = true;
            root.probed = true;
        }
    }

    Connections {
        target: Hyprland
        function onRawEvent(event) {
            root.trackEvent(event);
            if (event.name !== "configreloaded") return;
            root.refreshBinds();
            sync.running = true;
            hookCheck.running = true;
            themeTimer.restart(); // a reload resets decoration to the config file's values
        }
    }
}
