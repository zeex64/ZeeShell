{
    "name": "ZeeShell",
    "author": "ZeeShell",
    "description": "The ZeeShell desktop's look for Steam: the shell's surfaces, outlined cards, pill buttons and tabs, and an accent colour taken from your wallpaper. ZeeShell keeps colors.css in step with the desktop; restart Steam to pick up a new palette.",
    "version": "0.6.0",
    "tags": [
        "Dark",
        "Light",
        "Minimal",
        "Dynamic colours"
    ],
    "github": {
        "owner": "zeex64",
        "repo_name": "ZeeShell"
    },
    "Steam-WebKit": "webkit.css",
    "Patches": [
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "main.css",
            "TargetJs": "js/library.js"
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".ContextMenuPopup",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".DesktopToastContainer",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": "^https://store\\.steampowered\\.com/app/.*",
            "TargetJs": "js/store-app.js"
        },
        {
            "MatchRegexString": "^https://store\\.steampowered\\.com/?(\\?.*)?$",
            "TargetJs": "js/store-home.js"
        },
        {
            "MatchRegexString": "^https://store\\.steampowered\\.com/wishlist/.*",
            "TargetJs": "js/store-wishlist.js"
        },
        {
            "MatchRegexString": "^https://store\\.steampowered\\.com/.*",
            "TargetJs": "js/store-hub.js"
        }
    ]
}